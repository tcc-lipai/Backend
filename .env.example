# Copie este arquivo para ".env" (que NÃO vai pro Git) e preencha.
# O docker compose lê o ".env" automaticamente.

# Senha do usuário "sa" do SQL Server do container.
# Precisa ter 8+ caracteres com maiúscula, minúscula, número e símbolo (senão o SQL Server não sobe).
SA_PASSWORD=TroqueEstaSenha@123

# Chave que assina os tokens de login (JWT). Mínimo 32 caracteres, aleatória e secreta.
# Gerar uma:  openssl rand -base64 64     (ou:  [Convert]::ToBase64String((1..64 | % {Get-Random -Max 256}))  no PowerShell)
JWT_KEY=

# Conta de administrador
ADMIN_EMAIL=admin@exemplo.com
# Hash BCrypt da senha do admin (NÃO a senha em texto), entre ASPAS SIMPLES — o hash tem "$" e
# sem as aspas o compose tenta interpretá-lo como variável. Ex.: ADMIN_SENHA_HASH='$2a$11$....'
ADMIN_SENHA_HASH=

# --- opcionais (valores abaixo já são os padrões) ---
# Porta da API na sua máquina
API_PORT=5251
# Origens do Front liberadas no CORS
CORS_ORIGEM=http://localhost:5173
CORS_ORIGEM_2=http://localhost:5174
# Serviço de IA (rodando na máquina, fora do Docker)
IA_BASE_URL=http://host.docker.internal:8001
IA_MMS_BASE_URL=http://host.docker.internal:8000
# Popular conquistas/dicionário/produtos/conteúdo de exemplo no banco novo
POPULAR_DADOS_EXEMPLO=true
# Swagger (documentação interativa) em http://localhost:5251/
SWAGGER=false
